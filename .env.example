# Copy to .env.local for local development. Only public, browser-safe values belong here.
# Never put a service-role / secret key into any VITE_* variable: it would ship in the bundle.

# local | e2e | staging | production
VITE_APP_ENV=local

# Local Supabase (`pnpm db:start` prints both values)
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_…) or legacy anon JWT. Never the secret/service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
