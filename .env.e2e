# Non-secret placeholder configuration for `vite build --mode e2e` (Playwright smoke tests, CI bundle
# check). Without a session the app makes no Supabase requests, so the smoke tests run with these.
# The @supabase e2e tests need the local stack: `pnpm db:start && pnpm supabase:env --write-e2e`
# writes .env.e2e.local (gitignored, overrides these values) with the local URL and publishable key.
VITE_APP_ENV=e2e
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_000000000000000000000000
