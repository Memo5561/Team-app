{"nodes": [{"id": "claude", "label": "CLAUDE.md - TeamPanel Project Rules", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Project rules for Claude: read the spec first (source of truth), then decisions/risks, roadmap, architecture, data model and RLS docs. No AI in V1."}, {"id": "claude_phase_0_repository_foundation", "label": "Phase 0: Repository Foundation", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Completed including staging; next phase is Phase 1 (Auth). All recommendations in entscheidungen-und-risiken.md approved by the Product Owner (2026-10-19)."}, {"id": "claude_staging_environment", "label": "Staging Environment (teampanel-8i0.pages.dev / Supabase teampanel-staging)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_protected_main_branch", "label": "Protected main Branch Policy", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Work on own branch, merge only via PR with green CI; migrations reach staging only through the Deploy database workflow, never directly via the Supabase connector."}, {"id": "claude_pnpm_check", "label": "pnpm check (pre-commit quality gate)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Format, lint, typecheck and unit tests; must run before every commit."}, {"id": "claude_pnpm_db_types", "label": "pnpm db:types (DB type generation)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Regenerates database types (db:types via Docker, db:types:local without Docker); result must be committed."}, {"id": "claude_database_security_principle", "label": "Security Lives in the Database", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RLS on every public table, composite FKs (organization_id, x_id), status transitions/approvals only via SECURITY DEFINER RPCs with set search_path = ''. Frontend checks are UX only."}, {"id": "claude_secure_by_default", "label": "Secure by Default", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New table/permission/module means no access until explicitly allowed; the Owner implicitly has all permissions."}, {"id": "claude_entitlement_checks", "label": "Entitlement Checks Instead of Plan Names", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code queries entitlements such as entitlement('max_members'), never tariff/plan names."}, {"id": "claude_clock_events_append_only", "label": "Append-only clock_events (derived time_entries)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "clock_events is append-only with server-side timestamps; time_entries is derived from it."}, {"id": "claude_timestamptz_utc", "label": "UTC timestamptz Storage", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instants stored as timestamptz (UTC), displayed in location/organization timezone; shifts modelled as starts_at/ends_at."}, {"id": "claude_no_hardcoded_ui_texts_colors", "label": "No Hardcoded UI Texts or Colors", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI texts via i18n keys in src/i18n/de.json, colors via design tokens in src/styles/tokens.css (Tailwind default palette removed). Only exception: static meta tags in index.html."}, {"id": "claude_error_code_mapping", "label": "User-facing Error Code Mapping", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never show raw errors to users; map error codes via src/lib/errors.ts."}, {"id": "claude_no_secrets_in_repo", "label": "No Secrets in Repo / No Service-Role Key in Frontend", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_migrations_only_db_changes", "label": "DB Changes Only via Migrations", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All DB changes via supabase/migrations/; every new tenant table gets pgTAP isolation tests."}, {"id": "claude_layered_architecture", "label": "Frontend Layer Architecture (app -> modules -> platform -> components -> lib)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feature modules never import other modules; only src/modules/registry.ts or src/app wire modules. Cross-folder imports always via '@/'. New top-level src/ folders need an entry in config/eslint-plugin-teampanel.js; src/test only for *.test.* files."}, {"id": 