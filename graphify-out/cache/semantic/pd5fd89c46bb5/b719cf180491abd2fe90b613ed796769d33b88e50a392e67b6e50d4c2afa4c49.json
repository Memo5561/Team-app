{"nodes": [{"id": "docs_architecture_architektur", "label": "TeamPanel \u2013 Technische Architektur (V1)", "file_type": "document", "source_file": "docs/architecture/architektur.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_architektur_secure_by_default", "label": "Secure by default", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jede Tabelle hat RLS an, anon ohne Rechte, keine Policy = kein Zugriff; neue Permissions werden keiner Rolle automatisch gegeben (au\u00dfer Owner)."}, {"id": "docs_architecture_architektur_datenbank_als_sicherheitsgrenze", "label": "Datenbank ist die Sicherheitsgrenze", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mandantentrennung, Berechtigungen, Status\u00fcberg\u00e4nge und Tarif-Limits werden in PostgreSQL erzwungen; das Frontend spiegelt sie nur f\u00fcr UX."}, {"id": "docs_architecture_architektur_eine_quelle_der_wahrheit", "label": "Eine Quelle der Wahrheit pro Fakt", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zahlungsstatus und Preise leben in Stripe, Permission-/Modul-Katalog in DB-Migrationen, Arbeitszeit in clock_events, Limits in plan_entitlements."}, {"id": "docs_architecture_architektur_kein_applikationsserver", "label": "Kein eigener Applikationsserver", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a71/\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Geringe Betriebskosten (\u00a743) und kleine Angriffsfl\u00e4che: Supabase (DB, Auth, Storage, Edge Functions, Cron) plus statisches Frontend auf Cloudflare Pages; eine sp\u00e4tere \u00f6ffentliche API wird als eigene Schicht vor dieselben DB-Funktionen gesetzt."}, {"id": "docs_architecture_architektur_supabase", "label": "Supabase (EU-Region)", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_architektur_cloudflare_pages", "label": "Cloudflare Pages (statisches Frontend)", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_architektur_stripe", "label": "Stripe", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a72/\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_architektur_resend", "label": "Resend (E-Mail-Versand)", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a72/\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_architektur_edge_functions", "label": "Supabase Edge Functions (Deno)", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a72/\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drittanbieter (Stripe, Resend), Einladungsmails und Signaturpr\u00fcfung laufen hier, damit Secrets serverseitig bleiben."}, {"id": "docs_architecture_architektur_pg_cron", "label": "pg_cron Jobs", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_architektur_rpc_funktionen", "label": "RPC SQL-Funktionen (SECURITY DEFINER)", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mehrschritt-Operationen und Status\u00fcberg\u00e4nge laufen atomar in einer Transaktion mit expliziter Rechtepr\u00fcfung; Audit-Eintrag und Notification entstehen in derselben Transaktion. Einfache Listen/Einzel-Updates gehen direkt \u00fcber PostgREST unter RLS."}, {"id": "docs_architecture_architektur_multi_tenancy", "label": "Multi-Tenancy (Shared Schema, organization_id)", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared Database/Shared Schema mit organization_id auf jeder Mandantentabelle; RLS auf jeder public-Tabelle; aktive Organisation ist reiner Client-Zustand (URL-Segment)."}, {"id": "docs_architecture_architektur_zusammengesetzte_fremdschluessel", "label": "Zusammengesetzte Fremdschl\u00fcssel (organization_id, x_id)", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein einfacher FK verhindert keine Cross-Tenant-Referenz; UNIQUE (organization_id, id) plus zusammengesetzte FKs machen sie strukturell unm\u00f6glich, unabh\u00e4ngig von RLS."}, {"id": "docs_architecture_architektur_schema_private", "label": "Schema private (nicht exponiert)", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_architektur_identitaetsmodell", "label": "Identit\u00e4t: Account \u2260 Mitgliedschaft \u2260 Mitarbeiterdatensatz", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "auth.users/profiles sind der globale Account, memberships der firmenbezogene Mitarbeiterdatensatz; der Name geh\u00f6rt der Firma, damit Arbeitszeitnachweise auch nach Account-L\u00f6schung zuordenbar bleiben."}, {"id": "docs_architecture_architektur_vier_schranken", "label": "Autorisierung: vier Schranken", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tarif erlaubt (entitlement) \u2192 Modul aktiviert (module_enabled) \u2192 Rolle hat Permission (has_permission) \u2192 Datensatz im Scope (self/team/all \u2229 Standort); jede Schranke wird in der DB gepr\u00fcft und im Frontend nur gespiegelt."}, {"id": "docs_architecture_architektur_permission_scopes", "label": "Permission-Scopes .self/.team/.all", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lese- und Verwaltungsrechte f\u00fcr Personendaten existieren abgestuft, damit ein Teamleiter nur den Dienstplan seines Teams verwalten kann."}, {"id": "docs_architecture_architektur_standortbeschraenkung", "label": "Standortbeschr\u00e4nkung location_scope (all|assigned)", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default assigned (secure by default), Owner hat all; assigned reduziert auch .all auf zugewiesene Standorte."}, {"id": "docs_architecture_architektur_modulsystem", "label": "Modulsystem (DB-Katalog + Frontend-Registry)", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DB-Katalog ist ma\u00dfgeblich f\u00fcr Sicherheit, Registry f\u00fcr UI; Deaktivieren l\u00f6scht keine Daten, sperrt aber serverseitig \u00fcber module_enabled() in RLS; Module kommunizieren nur \u00fcber Plattform-Dienste (Marketplace-F\u00e4higkeit)."}, {"id": "docs_architecture_architektur_frontend_registry", "label": "Frontend-Registry src/modules/registry.ts (defineModule)", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_architektur_contract_test", "label": "Contract-Test Registry \u2194 DB-Katalog", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_architektur_entitlement_funktion", "label": "entitlement(org, key) Lookup", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Liefert Override \u2192 Plan-Wert \u2192 Default aus (secure by default); Code fragt nie nach dem Tarifnamen, immer nach einem Entitlement."}, {"id": "docs_architecture_architektur_stripe_webhook", "label": "Stripe-Webhook-Verarbeitung", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signatur pr\u00fcfen \u2192 INSERT INTO stripe_events ON CONFLICT DO NOTHING (Idempotenz) \u2192 Subscription frisch von Stripe abrufen statt dem Payload zu vertrauen (versp\u00e4tete/vertauschte Events) \u2192 subscriptions-Spiegel aktualisieren \u2192 Audit."}, {"id": "docs_architecture_architektur_access_state", "label": "Zugriffsstatus access_state (active/grace_period/restricted)", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wird aus Stripe-Status und Zeit abgeleitet statt separat gepflegt; restricted erlaubt Lesen und Stempeln, sperrt Verwaltung und Einladungen."}, {"id": "docs_architecture_architektur_clock_funktion", "label": "RPC clock(action) mit Zustandsmaschine", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sperrt time_clock_state per SELECT \u2026 FOR UPDATE und erlaubt nur g\u00fcltige \u00dcberg\u00e4nge (OFFLINE\u2192WORKING\u2192ON_BREAK\u2026); Server-Zeit now(); Doppelklick, zwei Ger\u00e4te und Retries erzeugen keine doppelten Events; client_request_id als Idempotenzschl\u00fcssel."}, {"id": "docs_architecture_architektur_zeitzonen", "label": "Zeit und Zeitzonen (timestamptz, business_date)", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alle Zeitpunkte als timestamptz (UTC); Zeitzone location.timezone \u2192 organization.timezone; ganzt\u00e4gige Dinge als date; Frontend nutzt date-fns/date-fns-tz statt nativer Date-Offsets."}, {"id": "docs_architecture_architektur_email_outbox_pattern", "label": "E-Mail Outbox-Pattern", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RPC schreibt in private.email_outbox; pg_cron ruft min\u00fctlich eine Edge Function, die via Resend mit Retry/Backoff versendet. Keine E-Mail geht verloren, keine wird bei zur\u00fcckgerollter Transaktion verschickt."}, {"id": "docs_architecture_architektur_polling_benachrichtigungen", "label": "Polling statt Realtime f\u00fcr Benachrichtigungen", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TanStack Query refetchInterval ~60 s plus Refetch bei Fensterfokus ist g\u00fcnstiger und robuster als Realtime (\u00a743 nur wo sinnvoll)."}, {"id": "docs_architecture_architektur_dateispeicher", "label": "Dateien: private Buckets und signierte URLs", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a712", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pfadschema {organization_id}/{bereich}/{uuid}.{ext}; kurzlebige signierte URLs; keine SVG-Uploads (XSS); V1 nur Bilder und PDF."}, {"id": "docs_architecture_architektur_audit_log", "label": "Audit Log via private.write_audit", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nur aus RPCs/Triggern geschrieben, Clients ohne Schreibrechte; before/after nur ge\u00e4nderte Felder (Datenminimierung); Aufbewahrung per Entitlement audit_log_retention_days."}, {"id": "docs_architecture_architektur_frontend_schichten", "label": "Frontend-Schichten: platform (Ebene A) / modules (Ebene B)", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a714", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feature-Module d\u00fcrfen nur platform, components und lib importieren, nie andere Module; Datenzugriff nur in queries/mutations als sp\u00e4tere Andockstelle f\u00fcr eine \u00f6ffentliche API."}, {"id": "docs_architecture_architektur_eslint_teampanel_layers", "label": "ESLint-Regel teampanel/layers (config/eslint-plugin-teampanel.js)", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a714", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_architektur_fehler_mapping", "label": "Fehler-Mapping lib/errors.ts (TP403/TP409/TP422)", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a714", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_architektur_tanstack_query", "label": "TanStack Query (orgId-pr\u00e4fixierte Query-Keys)", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a74/\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Query-Keys beginnen mit orgId, damit beim Organisationswechsel kein Cache durchleckt."}, {"id": "docs_architecture_architektur_ci_pipeline", "label": "CI-Pipeline (GitHub Actions: quality, database, e2e, security)", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a715", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_architektur_deploy_database_workflow", "label": "Workflow Deploy database", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a715", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migrationen nur per manuellem Workflow vom Default-Branch, nur bei gr\u00fcner CI, Dry-Run vor Apply, Production mit Freigabe; keine manuellen Produktions\u00e4nderungen."}, {"id": "docs_architecture_architektur_sentry", "label": "Sentry (EU, PII-Scrubbing)", "file_type": "concept", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a716", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_architektur_erweiterbarkeit", "label": "Erweiterbarkeit ohne V1-Ballast", "file_type": "rationale", "source_file": "docs/architecture/architektur.md", "source_location": "\u00a717", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V1 bereitet \u00f6ffentliche API, Webhooks, KI und Marketplace strukturell vor (gekapselter Datenzugriff, DB-RPCs, Outbox, Modul-Katalog), implementiert sie aber bewusst nicht."}], "edges": [{"source": "docs_architecture_architektur", "target": "docs_product_spezifikation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/architektur.md", "source_location": "L3", "weight": 1.0}, {"source": "docs_architecture_architektur", "target": "docs_architecture_datenmodell", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/architektur.md", "source_location": "L5", "weight": 1.0}, {"source": "docs_architecture_architektur", "target": "docs_security_rls_und_berechtigungen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/architektur.md", "source_location": "L6", "weight": 1.0}, {"source": "docs_architecture_architektur", "target": "docs_architecture_entscheidungen_und_risiken", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/architektur.md", "source_location": "L7", "weight": 1.0}, {"source": "docs_architecture_architektur", "target": "docs_roadmap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/architektur.md", "source_location": "L8", "weight": 1.0}, {"source": "docs_architecture_architektur", "target": "docs_architecture_entscheidu